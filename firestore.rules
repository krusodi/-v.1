rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'krusodi.ns@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSchool(data) {
      return data.id is string &&
             data.id.size() <= 100 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 50 &&
             data.appData is map &&
             (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 200)) &&
             (!('lastUpdatedBy' in data) || (data.lastUpdatedBy is string && data.lastUpdatedBy.size() <= 100)) &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 150)) &&
             (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128));
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.uid.size() <= 128 &&
             data.email is string &&
             data.email.size() <= 150 &&
             data.role in ['ADMIN', 'USER'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 50));
    }

    // Connectivity test probe
    match /test/{testId} {
      allow read: if true;
      allow write: if isVerifiedUser();
    }

    // School main data collections (e.g. data69-school)
    match /schools/{schoolId} {
      allow read: if true;
      allow create: if isValidId(schoolId) && isValidSchool(incoming());
      allow update: if isValidId(schoolId) && isValidSchool(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid && isValidUser(incoming());
      allow delete: if isAdmin();
    }
  }
}
